# ============================================================
#  TestGhost v2 — .env.example
#  Copy this to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ── Anthropic ────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Gemini / Google AI ───────────────────────────────────────
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# ── Database ─────────────────────────────────────────────────
# Matches docker-compose.yml defaults
POSTGRES_USER=testghost
POSTGRES_PASSWORD=testghost_secret
POSTGRES_DB=testghost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy URL (used by FastAPI backend)
DATABASE_URL=postgresql+asyncpg://testghost:testghost_secret@localhost:5432/testghost

# Sync URL (used by Alembic migrations only)
DATABASE_URL_SYNC=postgresql+psycopg2://testghost:testghost_secret@localhost:5432/testghost

# ── Backend ──────────────────────────────────────────────────
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ── Proxy ────────────────────────────────────────────────────
PROXY_PORT=8080

# ── AI settings ──────────────────────────────────────────────
# Model used for all LangGraph nodes
CLAUDE_MODEL=claude-sonnet-4-6
# Timeout in seconds for each LLM call (prevents hangs)
LLM_TIMEOUT_SECONDS=30
# Max tokens per LLM response
LLM_MAX_TOKENS=2000

# ── ML settings ──────────────────────────────────────────────
# Cosine similarity threshold for RAG deduplication (0.0–1.0)
DEDUP_SIMILARITY_THRESHOLD=0.92
# Isolation Forest anomaly threshold (negative = more anomalous)
ANOMALY_SCORE_THRESHOLD=-0.1
# Minimum requests in a session before clustering runs
MIN_REQUESTS_FOR_CLUSTERING=6
# Minimum requests before anomaly model trains
MIN_REQUESTS_FOR_ANOMALY_TRAINING=50
# Path to saved Isolation Forest model
ANOMALY_MODEL_PATH=models/isolation_forest.pkl
# HuggingFace model cache directory
SENTENCE_TRANSFORMERS_HOME=models/embeddings_cache

# ── DeepEval ─────────────────────────────────────────────────
# Get from: https://app.deepeval.com/
DEEPEVAL_API_KEY=your-deepeval-key-here
# Minimum score to accept a generated test (0.0–1.0)
EVAL_PASS_THRESHOLD=0.70
# Maximum retries for a failing test
EVAL_MAX_RETRIES=2

# ── Output ───────────────────────────────────────────────────
OUTPUT_DIR=output
TESTS_OUTPUT_DIR=output/tests
REPORTS_OUTPUT_DIR=output/reports

# ── Security ─────────────────────────────────────────────────
# Set to true to reject requests with bodies larger than MAX_BODY_BYTES
ENFORCE_BODY_SIZE_LIMIT=true
MAX_BODY_BYTES=51200

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
